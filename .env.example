# Copy to .env for local use (server.js loads it outside production). Never commit .env.
PORT=8080
PUBLIC_URL=http://localhost:8080
# Production: 32+ random characters, or leave empty and the server makes one and keeps it in DATA_DIR/session-secret
SESSION_SECRET=
# Database, backups, uploaded photos. Default .data/ (production default /home/data)
DATA_DIR=
# First run only: ALLOW_DEFAULT_ADMIN=1 makes admin/admin. Otherwise ADMIN_PASSWORD, else a random one is printed once.
ALLOW_DEFAULT_ADMIN=
ADMIN_PASSWORD=
# Production refuses to start with ALLOW_DEFAULT_ADMIN=1 or an ADMIN_PASSWORD under 12 characters.
# Set to 1 ONLY behind a proxy (Azure, nginx, Cloudflare) that appends the real client address to X-Forwarded-For.
# Otherwise leave empty: the header is ignored (it can be forged) and the socket address is used for rate limits.
TRUST_PROXY=
