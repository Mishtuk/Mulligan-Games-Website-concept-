---
// Shared page frame: head, open-now strip, header, footer. Every value comes from src/content/store.json and is printed with {} (escaped).
// The strip's status is a live region (<!--mg:strip-->) the server fills; the baked text is what a page shows if the server cannot.
import '../styles/global.css';
import store from '../content/store.json';
import { safeUrl } from '../lib/events.js';
import Icon from './Icon.astro';
import ThemeFab from './ThemeFab.astro';

const { title = '', description = '', current = '', skip = '#main', skipLabel = 'Skip to the events', dynamicHead = false } = Astro.props;
const origin = (Astro.site ?? new URL('http://localhost:8080')).origin; // baked default; server.js swaps it for PUBLIC_URL via the mg:origin marker
const o = `<!--mg:origin-->${origin}<!--/mg:origin-->`;
const ogImage = `${o}/img/og/mulligan-games-og.jpg`;
const a = store.address;
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${store.name} ${a.street} ${a.city} ${a.region} ${a.zip}`)}`;
const tel = safeUrl(store.phoneHref);
const social = [['Facebook', 'facebook'], ['Instagram', 'instagram'], ['TikTok', 'tiktok'], ['X', 'x'], ['TopDeck', 'topdeck']].map(([n, k]) => [n, safeUrl(store.links?.[k])]).filter(([, u]) => u);
const nav = [['All events', '/events/', 'events'], ['This week', '/#week', 'home'], ['cEDH', '/#cedh', ''], ['Preorders', '/#new', ''], ['Visit', '/#visit', '']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>try { var s = localStorage.getItem('mg-scheme'); if (s) document.querySelector('meta[name="color-scheme"]').content = s; } catch (e) {}</script>
    {dynamicHead ? <Fragment set:html="<!--mg:head-->" /> : <>
      <title>{title}</title><meta name="description" content={description} />
      <link rel="canonical" href={`${o}${Astro.url.pathname}`} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={`${o}${Astro.url.pathname}`} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={store.name} />
    <meta property="og:image" content={ogImage} /><meta name="twitter:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Mulligan Games logo on its sign plate, next to the play room doorway" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#6B3A2C" />
    <link rel="icon" href="/img/logo/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/img/logo/logo-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo.woff2" crossorigin />
    <slot name="head" />
    <script src="/js/site.js" defer is:inline></script>
  </head>
  <body>
    <a class="skip" href={skip}>{skipLabel}</a>

    <div class="openbar">
      <div class="wrap openbar-in">
        <Fragment set:html="<!--mg:strip--><p class='ob-status'><span class='ob-dot' aria-hidden='true'></span><span><strong>Hours coming soon.</strong> Call the shop for today’s hours.</span></p><!--/mg:strip-->" />
        <Fragment set:html="<!--mg:bar-->" />
        <p class="ob-addr">{a.street}, {a.city}</p>
        {tel && <a class="ob-link" href={tel}><Icon name="phone" /><span class="ob-long">{store.phone}</span><span class="ob-short">Call</span></a>}
        <a class="ob-link" href={maps} target="_blank" rel="noopener"><Icon name="pin" />Directions<span class="vh"> (opens Google Maps)</span></a>
        <Fragment set:html="<!--/mg:bar-->" />
      </div>
    </div>

    <header class="site-head">
      <div class="wrap head-in">
        <a class="plate" href="/" aria-label={`${store.name}, home`}>
          <img src="/img/logo/logo-plate-330.webp" alt="" width="330" height="102" />
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map(([label, href, id]) => <li><a href={href} aria-current={id && id === current ? 'page' : undefined}>{label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-foot">
      <!-- the footer is an index (round 4, F10): brand | Visit | Hours | Explore, then a hairline row. Visit and Hours are filled live (mg:foot-addr). -->
      <div class="wrap foot-in">
        <div class="foot-brand">
          <p class="foot-plate"><img src="/img/logo/logo-plate-330.webp" alt={store.name} width="330" height="102" loading="lazy" /></p>
          <p>Card games, tables and a crew who know the formats.</p>
        </div>
        <Fragment set:html="<!--mg:foot-addr-->" />
        <div class="foot-visit">
          <h2>Visit</h2>
          <p>{a.street}<br />{a.city}, {a.region} {a.zip}</p>
          <p>{tel ? <a href={tel}>{store.phone}</a> : store.phone}</p>
          <p><a href={maps} target="_blank" rel="noopener">Directions<span class="vh"> (opens Google Maps)</span></a></p>
        </div>
        <div class="foot-hours"><h2>Hours</h2><p><a href="/#visit">See the hours</a></p></div>
        <Fragment set:html="<!--/mg:foot-addr-->" />
        <nav class="foot-explore" aria-labelledby="foot-explore-h">
          <h2 id="foot-explore-h">Explore</h2>
          <ul>
            <li><a href="/events/">All events</a></li>
            <li><a href="/#week">This week</a></li>
            <li><a href="/#cedh">cEDH</a></li>
            <li><a href="/#new">Preorders</a></li>
            <li><a href="/new-here/">New here?</a></li>
          </ul>
        </nav>
        <ul class="foot-small foot-links">
          <li><a href="/events.ics">Calendar feed</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <Fragment set:html="<!--mg:socials-->" />
          {social.map(([n, u]) => <li><a href={u} target="_blank" rel="noopener">{n}<span class="vh"> (opens in a new tab)</span></a></li>)}
          <Fragment set:html="<!--/mg:socials-->" />
          <li><a href="/admin/">Staff sign-in</a></li>
        </ul>
      </div>
    </footer>

    <!-- Phone quick actions (D33): plain links, shown under 900px by global.css, hidden in print -->
    <nav class="mobile-bar" aria-label="Quick actions">
      <a href="/events/" aria-current={current === 'events' ? 'page' : undefined}>Events</a>
      <a href="/#visit">Hours</a>
      <a href={maps} target="_blank" rel="noopener">Directions<span class="vh"> (opens Google Maps)</span></a>
      {tel && <a href={tel}>Call</a>}
    </nav>

    <ThemeFab /><!-- light/dark button reused from the VFW site (D46) -->
  </body>
</html>
