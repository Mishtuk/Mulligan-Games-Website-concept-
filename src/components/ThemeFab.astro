---
/**
 * Light/dark switch, reused from the Warminster VFW site (src/components/ThemeFab.astro there; owner, D46):
 * a small round button fixed at the bottom-right. A moon in light mode, a sun in dark mode.
 * Mulligan differences only: the theme lives in <meta name="color-scheme"> (set before first paint from mg-scheme),
 * the colours use this site's tokens, and on phones it sits above the quick-actions bar (D33) / admin tab bar.
 */
---
<button type="button" class="theme-fab" aria-label="Switch to dark mode" data-next="dark">
  <svg class="ico-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z" /></svg>
  <svg class="ico-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></svg>
</button>

<script>
  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const btn = document.querySelector<HTMLButtonElement>('.theme-fab');
  if (btn && meta) {
    const now = () => (meta.content === 'light' || meta.content === 'dark' ? meta.content : mq.matches ? 'dark' : 'light');
    const paint = () => {
      const next = now() === 'dark' ? 'light' : 'dark';
      btn.dataset.next = next;
      btn.setAttribute('aria-label', `Switch to ${next} mode`);
    };
    btn.addEventListener('click', () => {
      const t = now() === 'dark' ? 'light' : 'dark';
      const sys = mq.matches ? 'dark' : 'light';
      meta.content = t === sys ? 'light dark' : t; // back to the system's own scheme = follow the system again
      try { if (t === sys) localStorage.removeItem('mg-scheme'); else localStorage.setItem('mg-scheme', t); } catch (e) { /* storage blocked: the choice lasts for this visit */ }
      paint();
    });
    addEventListener('storage', (e) => { if (e.key === 'mg-scheme') { meta.content = e.newValue || 'light dark'; paint(); } });
    mq.addEventListener('change', paint);
    paint();
  }
</script>

<style>
  .theme-fab {
    position: fixed; z-index: 60; right: max(12px, env(safe-area-inset-right)); bottom: max(12px, env(safe-area-inset-bottom));
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border-radius: 50%;
    background: var(--surface); color: var(--ink); border: 1px solid var(--ink-2); box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
    opacity: 0.88; cursor: pointer; transition: opacity 0.2s, background-color 0.2s;
  }
  .theme-fab:hover, .theme-fab:focus-visible { opacity: 1; }
  .theme-fab:focus-visible { outline: 3px solid var(--focus, var(--ink)); outline-offset: 3px; }
  .theme-fab svg { grid-area: 1 / 1; width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; transition: transform 0.4s ease, opacity 0.3s ease; }
  /* data-next names the theme the button switches to: next=dark means it is light now, so show the moon */
  .theme-fab[data-next='dark'] .ico-sun, .theme-fab[data-next='light'] .ico-moon { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  .theme-fab[data-next='dark'] .ico-moon, .theme-fab[data-next='light'] .ico-sun { opacity: 1; transform: none; }
  /* Mulligan: stay above the phone quick-actions bar (public, under 900px) and the admin tab bar (under 1024px) */
  @media (max-width: 899px) { :global(body:has(.mobile-bar)) .theme-fab { bottom: calc(56px + 12px + env(safe-area-inset-bottom)); } }
  @media (max-width: 1023px) { :global(body:has(.adm-tabs)) .theme-fab { bottom: calc(4rem + 12px + env(safe-area-inset-bottom)); } }
  @media (scripting: none) { .theme-fab { display: none; } }
  @media (prefers-reduced-motion: reduce) { .theme-fab svg, .theme-fab { transition: none; } }
  @media print { .theme-fab { display: none; } }
</style>
