        const unmark = (d) => { clearErr(d); d.querySelectorAll('[aria-invalid]').forEach((c) => c.removeAttribute('aria-invalid')); };

        // opening hours: one row per weekday, Closed toggle, "not set yet" switch
        const unset = h('input', { type: 'checkbox', name: 'hoursUnset', checked: !Array.isArray(v.hours) });
        const days = WEEK.map((d) => {
          const r = (v.hours || []).find((x) => x.day === d) || {};
          const closed = h('input', { type: 'checkbox', name: `closed.${d}`, checked: !!r.closed }), open = h('input', { type: 'time', name: `open.${d}`, value: r.open || '' }),
            close = h('input', { type: 'time', name: `close.${d}`, value: r.close === '24:00' ? '00:00' : r.close || '' }), note = h('span', { class: 'hint hnote', 'aria-live': 'polite' });
          const row = h('div', { class: 'fld hrow' }, h('p', { class: 'lbl hday' }, DAYN[d]), h('label', { class: 'check hclosed' }, closed, h('span', {}, 'Closed')),
            h('label', { class: 'tl' }, 'Opens', open), h('label', { class: 'tl' }, 'Closes', close), note, h('p', { class: 'ferr', role: 'alert', hidden: true }));
          const sync = () => {
            open.parentElement.hidden = close.parentElement.hidden = closed.checked;
            note.textContent = !closed.checked && isT(open.value) && isT(close.value) ? (close.value === '00:00' ? 'Closes at midnight.' : close.value <= open.value ? `Closes at ${T12(close.value)} the next morning.` : '') : '';
          };
          row.addEventListener('input', () => { unmark(row); sync(); }); row.addEventListener('change', () => { unmark(row); sync(); });
          sync();
          return row;
        });
        const hoursBox = h('div', { class: 'wide' }, days), unsetSay = h('p', { class: 'say wide' }, 'The website says "Hours coming soon" and shows no hours table until you set them.');
        const tick = () => { hoursBox.hidden = unset.checked; unsetSay.hidden = !unset.checked; };
        unset.addEventListener('change', tick); tick();
        const hoursFld = h('div', { class: 'fld wide' }, h('label', { class: 'check' }, unset, h('span', {}, 'Hours are not set yet')), h('p', { class: 'ferr', role: 'alert', hidden: true }));
        hoursFld.addEventListener('change', () => unmark(hoursFld));

        // special days (holidays, special hours)
        const orows = h('div', { class: 'wide orows' });
        const addOv = (o = {}) => {
          const date = h('input', { type: 'date', name: 'o-date', value: o.date || '' }), closed = h('input', { type: 'checkbox', name: 'o-closed', checked: o.date ? !!o.closed || !o.open : true }),
            open = h('input', { type: 'time', name: 'o-open', value: o.open || '' }), close = h('input', { type: 'time', name: 'o-close', value: o.close === '24:00' ? '00:00' : o.close || '' }),
            note = h('input', { type: 'text', name: 'o-note', maxlength: 120, value: o.note || '', placeholder: 'Closed for Thanksgiving' });
          const rm = h('button', { class: 'btn alt sm', type: 'button', onclick: () => { row.remove(); form.dispatchEvent(new Event('dates')); } }, ico('bin', 18), 'Remove', h('span', { class: 'vh' }, ' this special day'));
          const row = h('div', { class: 'fld orow' }, h('label', { class: 'tl' }, 'Date', date), h('label', { class: 'check hclosed' }, closed, h('span', {}, 'Closed')), rm,
            h('label', { class: 'tl' }, 'Opens', open), h('label', { class: 'tl' }, 'Closes', close), h('label', { class: 'tl onote' }, 'Note shown on the website', note), h('p', { class: 'ferr', role: 'alert', hidden: true }));
          const sync = () => { open.parentElement.hidden = close.parentElement.hidden = closed.checked; };
          row.addEventListener('input', () => { unmark(row); sync(); }); row.addEventListener('change', () => { unmark(row); sync(); });
          sync(); orows.append(row);
        };
        (v.hourOverrides || []).forEach(addOv);
        const ovEmpty = h('p', { class: 'meta wide' }, 'No special days. Add one for a holiday or a day with different hours.');
        const noteOv = () => { ovEmpty.hidden = orows.children.length > 0; };
        form.addEventListener('dates', noteOv);

        // photo, alt text
        const picker = photoPicker(v.photo), alt = inp('photoAlt', v.photoAlt, { max: 160, ph: 'Tables set up for a Friday night draft' });
        const altFld = fld('s-alt', 'Describe the picture', alt, { hint: 'For people who cannot see it. Needed when there is a picture.' });
        const showAlt = () => { altFld.hidden = !form.elements.photo.value; };

        const L = (id, label, name, cur, x = {}) => fld(id, label, inp(name, cur, x), x);
        put(form, h('div', { class: 'errsum', role: 'alert', tabindex: '-1', hidden: true }),
          group('Opening hours', hoursFld, unsetSay, hoursBox),
          group('Holidays and special days', h('p', { class: 'meta wide' }, 'These replace the usual hours for that one date. Closed days show on the website with your note.'), orows, ovEmpty,
            h('div', { class: 'wide' }, h('button', { class: 'btn alt sm', type: 'button', onclick: () => { addOv(); form.dispatchEvent(new Event('dates')); } }, ico('plus', 18), 'Add a special day'))),
          group('Where and how to reach you', L('s-street', 'Street address', 'address.street', v.address?.street, { auto: 'street-address' }), L('s-city', 'Town', 'address.city', v.address?.city, { half: true }),
            L('s-region', 'State', 'address.region', v.address?.region, { half: true, max: 2, ph: 'PA' }), L('s-zip', 'ZIP code', 'address.zip', v.address?.zip, { half: true, mode: 'numeric', max: 10 }),
            L('s-phone', 'Phone', 'phone', v.phone, { half: true, type: 'tel', ph: '(215) 555-0100', auto: 'tel' }), L('s-email', 'Email', 'email', v.email, { half: true, optional: true, type: 'email', max: 120 })),
          group('Links', ST.links.map(([k, label]) => L(`s-link-${k}`, label, `links.${k}`, v.links?.[k], { half: true, optional: true, ph: 'https://', max: 500 }))),
          group('Notes for visitors', L('s-free', 'Free-play line', 'freePlay', v.freePlay, { optional: true, max: 120, hint: 'For example: Free Play All Day, Everyday.' }),
            L('s-parking', 'Parking note', 'parking', v.parking, { optional: true, max: 300 }), L('s-kids', 'Kids and ages', 'kids', v.kids, { optional: true, max: 300, hint: 'Your age policy, in your words.' }),
            L('s-tag', 'One line about the shop', 'tagline', v.tagline, { optional: true, max: 160, hint: 'Used in the description Google shows.' })),
          group('Room photo', picker, altFld));
        showAlt();

        function read() {
          const hours = unset.checked ? null : WEEK.slice().sort((a, b) => a - b).map((d) => (form.elements[`closed.${d}`].checked ? { day: d, closed: true } : { day: d, open: val(`open.${d}`), close: val(`close.${d}`) }));
          const hourOverrides = [...orows.children].map((r) => {
            const q = (n) => r.querySelector(`[name=${n}]`), c = q('o-closed').checked;
            return { date: q('o-date').value, ...(c ? { closed: true } : { open: q('o-open').value, close: q('o-close').value }), note: q('o-note').value.trim() };
          });
          const photo = val('photo');
          return { address: { street: val('address.street'), city: val('address.city'), region: val('address.region'), zip: val('address.zip') }, phone: val('phone'), email: val('email'),
            hours, hourOverrides, links: Object.fromEntries(ST.links.map(([k]) => [k, val(`links.${k}`)])), freePlay: val('freePlay'), parking: val('parking'), kids: val('kids'), tagline: val('tagline'),
            photo, photoAlt: photo ? val('photoAlt') : '' };
        }
        const ctlOf = (k) => {
          let m;
          if (k === 'hours') return unset;
          if ((m = /^hours\.(\d)$/.exec(k))) return form.elements[`open.${m[1]}`];
          if (k === 'hourOverrides') return orows.children[0]?.querySelector('[name=o-date]');
          if ((m = /^hourOverrides\.(\d+)(?:\.(date|note))?$/.exec(k))) return orows.children[+m[1]]?.querySelector({ date: '[name=o-date]', note: '[name=o-note]' }[m[2]] || '[name=o-open]');
          if (k === 'photo') return form.elements.photo;
          return form.elements[k];
        };
        const sum = () => $('.errsum', form);
        const clearAll = () => { form.querySelectorAll('.fld.bad').forEach(unmark); sum().hidden = true; };
        function showErrors(errors) {
          const items = Object.entries(errors).map(([k, m]) => ({ m, c: ctlOf(k) }));
          for (const { c, m } of items) if (c?.closest('.fld')) markErr(c, m);
          put(sum(), h('strong', {}, items.length === 1 ? '1 thing needs fixing' : `${items.length} things need fixing`),
            h('ul', {}, items.map(({ m, c }) => h('li', {}, c && c.type !== 'hidden' ? h('a', { href: '#', onclick: (e) => { e.preventDefault(); c.focus(); } }, m) : m))));
          sum().hidden = false; sum().scrollIntoView({ block: 'center' }); sum().focus();
        }

        const base = JSON.stringify(read()), msg = h('span', { class: 'sb-msg', 'aria-live': 'polite' }), discard = h('button', { class: 'btn alt', type: 'button' }, 'Cancel');
        let dirty = false;
        const upd = () => { showAlt(); noteOv(); dirty = JSON.stringify(read()) !== base; msg.textContent = dirty ? 'You have unsaved changes' : ''; discard.textContent = dirty ? 'Discard' : 'Cancel'; };
        discard.addEventListener('click', () => { guard = null; drawStore(); });
        form.addEventListener('input', upd); form.addEventListener('change', upd); form.addEventListener('dates', upd);
        form.addEventListener('submit', async (e) => {
          e.preventDefault(); clearAll();
          const r = await api('PUT', 'admin/store', read());
          if (!r.ok) { if (r.status === 422) showErrors(r.data.errors); else toast(say(r)); return; }
          guard = null; ST.store = r.data.store; drawStore(); toast('Saved. The website shows it now.');
        });
        form.append(h('div', { class: 'savebar' }, msg, discard, h('button', { class: 'btn', type: 'submit' }, 'Save store info')));
        put(sec, h('div', { class: 'head' }, h('h1', {}, 'Store info')), h('p', {}, 'Hours, address, links and notes. Saving updates the opening-hours strip, the hours table, the footer, Google data and the calendar location at once.'), form);
        noteOv();
        guard = () => dirty && 'What you typed has not been saved.';
      }

      // ---------- navigation ----------
      const VIEWS = { dashboard: renderDashboard, events: renderEvents, store: renderStore, security: renderSecurity, account: renderAccount };
      let cur = '', restoring = false;
      function show() {
        const v = VIEWS[location.hash.slice(1)] ? location.hash.slice(1) : 'dashboard';
        cur = v; $('#mnav').open = false;
        document.querySelectorAll('[data-section]').forEach((s) => (s.hidden = s.dataset.section !== v));
        document.querySelectorAll('[data-view]').forEach((a) => (a.dataset.view === v ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current')));
        VIEWS[v]();
      }
      async function start() {
        const r = await api('GET', 'admin/state');
        if (!r.ok) return showLogin();
        S = r.data;
        put($('#links'), navLinks()); put($('#tail'), navTail()); put($('#mlinks'), navLinks(), navTail());
        $('#gate').hidden = true; $('#app').hidden = false;
        $('#default-warning').hidden = !S.defaultPassword;
        show();
      }
      addEventListener('hashchange', async () => {
        if (!S) return;
        if (restoring) { restoring = false; return; }
        if (!(await leave())) { restoring = true; location.hash = cur; return; }
        show();
      });
      addEventListener('beforeunload', (e) => { if (guard?.()) e.preventDefault(); });
      start();
    </script>
  </body>
</html>
