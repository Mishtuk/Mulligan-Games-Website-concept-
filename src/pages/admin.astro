---
// Store admin. A static page with no secrets: signed-out visitors see the sign-in form, and every read or save goes to /api/admin/*,
// where server.js checks the session cookie. Plain on purpose: big text, big buttons, one thing per screen (staff use it at the counter).
// The look is provisional until DESIGN.md is signed off.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | Mulligan Games</title>
    <style is:global>
      :root { --night: #16161d; --on-dark: #eeeef4; --accent: #b9b2ff; --paper: #ececf1; --card: #fafafc; --stone: #dedee6; --ink: #1d1d26; --ink-2: #4a4a58; --field: #5a5a6a; --line: rgb(29 29 38 / .18);
        --gold-ink: #6a521d; --warn-bg: #f3e7c6; --red-ink: #8a2328; --bad-bg: #f4dedb; --olive: #3f5a2b; --ok-bg: #e2ead6; --edit: #24405f; --edit-bg: #dfe6ee; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink); font: 19px/1.55 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
      h1, h2, .num { font-weight: 700; }
      h1 { font-size: 2rem; margin: 0 0 .5rem; line-height: 1.2; }
      h2 { font-size: 1.4rem; margin: 0 0 .75rem; line-height: 1.25; }
      a { color: var(--ink); }
      [hidden] { display: none !important; }
      :focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
      .side :focus-visible, .top :focus-visible, .toast :focus-visible { outline-color: var(--accent); }
      .ic { display: inline-flex; flex: none; vertical-align: middle; }

      .wrap { display: grid; grid-template-columns: 16rem minmax(0, 1fr); min-height: 100vh; }
      .top { display: none; }
      .side { background: var(--night); color: var(--on-dark); position: sticky; top: 0; height: 100vh; overflow: auto; display: flex; flex-direction: column; padding: 1.25rem .75rem; }
      .brand { padding: 0 .5rem 1.25rem; }
      .wordmark { font-weight: 800; font-size: 1.3rem; letter-spacing: .02em; color: var(--on-dark); text-decoration: none; }
      .brand p { margin: .35rem 0 0; font-weight: 600; color: var(--accent); }
      .side nav, .tail { display: grid; gap: 2px; }
      .tail { margin-top: auto; padding-top: 1rem; }
      .side a:not(.wordmark), .side .linkbtn, .mnav a, .mnav .linkbtn { display: flex; align-items: center; gap: .7rem; min-height: 52px; padding: 0 .8rem; border-radius: 6px; font: 600 1.05rem/1.2 system-ui, sans-serif; color: var(--on-dark); text-decoration: none; position: relative; width: 100%; background: none; border: 0; cursor: pointer; text-align: left; }
      .side a:hover, .side .linkbtn:hover, .mnav a:hover, .mnav .linkbtn:hover { background: rgb(238 238 244 / .08); }
      a[aria-current='page'] { background: rgb(185 178 255 / .16); color: var(--accent) !important; }
      a[aria-current='page']::before { content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 4px; background: var(--accent); border-radius: 2px; }
      .linkbtn { text-decoration: underline; }

      .main { padding: 1.5rem; max-width: 60rem; width: 100%; min-width: 0; }
      .banner { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; justify-content: space-between; background: var(--bad-bg); color: var(--red-ink); font-weight: 700; border-radius: 6px; padding: .8rem 1rem; margin-bottom: 1.25rem; }
      .card { background: var(--card); border-radius: 6px; padding: 1.25rem; margin: 0 0 1.25rem; box-shadow: 0 1px 2px rgb(29 29 38 / .12); }
      .head { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
      .head h1 { margin: 0; }
      .meta, .hint { color: var(--ink-2); font-size: .95rem; }
      .big { font-size: 1.15rem; font-weight: 700; margin: 0 0 .25rem; }

      .fld { margin: 0 0 1.1rem; }
      .fld > label { display: block; font-weight: 600; }
      .opt { font-size: .85rem; font-weight: 500; color: var(--ink-2); margin-left: .5rem; }
      .hint { display: block; }
      input[type=text], input[type=password], input[type=time], input[type=date], input[type=tel], input[type=email], select, textarea { display: block; width: 100%; min-height: 52px; margin-top: .3rem; padding: .55rem .7rem; font: inherit; color: inherit; background: var(--card); border: 2px solid var(--field); border-radius: 6px; }
      .fld.bad input { border-color: var(--red-ink); }
      .ferr, .err { color: var(--red-ink); font-weight: 700; margin: .3rem 0 0; }

      .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; font: inherit; font-weight: 700; min-height: 48px; padding: .5rem 1.1rem; border-radius: 6px; border: 2px solid var(--night); background: var(--night); color: var(--on-dark); cursor: pointer; text-decoration: none; }
      .btn.alt { background: var(--card); color: var(--ink); border-color: var(--ink); }
      .btn.danger { background: var(--card); color: var(--red-ink); border-color: var(--red-ink); }
      .row { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
      .chip { display: inline-block; font-size: .85rem; font-weight: 700; padding: .15rem .55rem; border-radius: 999px; background: var(--stone); color: var(--ink-2); line-height: 1.4; vertical-align: middle; }
      .chip.ok { background: var(--ok-bg); color: var(--olive); } .chip.warn { background: var(--warn-bg); color: var(--gold-ink); }

      .seg { display: flex; flex-wrap: wrap; gap: .5rem; }
      .seg .btn[aria-pressed=true] { background: var(--night); color: var(--on-dark); border-color: var(--night); }
      .tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
      .tile { margin: 0; padding: 1rem; }
      .tl { font-size: .95rem; font-weight: 600; color: var(--ink-2); }
      .num { font-size: 2.75rem; line-height: 1.15; }
      .chg { font-size: .95rem; display: flex; gap: .3rem; align-items: center; color: var(--ink-2); }
      .chg.up { color: var(--olive); }
      .chart { width: 100%; height: auto; display: block; }
      .chart text { font-size: 13px; fill: var(--ink-2); }
      .chart .gl { stroke: var(--line); }
      .chart .bar { fill: var(--ink-2); } .chart .bar.hi { fill: var(--ink); }
      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.25rem; }
      ul.rank { list-style: none; margin: 0; padding: 0; }
      ul.rank li { position: relative; display: flex; justify-content: space-between; gap: 1rem; align-items: center; min-height: 44px; padding: 0 .5rem; }
      ul.rank .bg { position: absolute; left: 0; top: 4px; bottom: 4px; background: rgb(74 74 88 / .14); border-radius: 4px; }
      ul.rank .nm, ul.rank .ct { position: relative; } ul.rank .ct { font-variant-numeric: tabular-nums; font-weight: 700; }

      .ev { display: flex; gap: .85rem; align-items: flex-start; min-height: 56px; padding: .6rem 0; border-top: 1px solid var(--line); }
      .ev:first-of-type { border-top: 0; }
      .evi { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--stone); color: var(--ink-2); }
      .evi.ok { background: var(--ok-bg); color: var(--olive); } .evi.warn { background: var(--warn-bg); color: var(--gold-ink); }
      .evi.bad { background: var(--bad-bg); color: var(--red-ink); } .evi.edit { background: var(--edit-bg); color: var(--edit); }
      .ev details summary { cursor: pointer; font-size: .95rem; color: var(--ink-2); min-height: 44px; display: inline-flex; align-items: center; padding: 0 .5rem; }

      .gate { max-width: 28rem; margin: 3rem auto; padding: 0 1rem; }
      .gate .wordmark { color: var(--ink); display: block; margin-bottom: 1rem; }
      .toast { position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%); background: var(--night); color: var(--on-dark); padding: .5rem .5rem .5rem 1.25rem; border-radius: 6px; z-index: 20; display: flex; gap: .75rem; align-items: center; min-height: 48px; max-width: calc(100vw - 2rem); }
      .toast button { background: none; border: 0; color: var(--accent); font: inherit; font-weight: 700; min-height: 48px; padding: 0 .75rem; cursor: pointer; text-decoration: underline; }
      dialog.ask { border: 0; border-radius: 6px; padding: 1.5rem; max-width: 28rem; width: calc(100vw - 2rem); background: var(--card); color: var(--ink); }
      dialog.ask::backdrop { background: rgb(22 22 29 / .6); }
      textarea { resize: vertical; }
      .lbl { font-weight: 600; margin: 0; }
      .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .chip.bad { background: var(--bad-bg); color: var(--red-ink); } .chip.edit { background: var(--edit-bg); color: var(--edit); }
      .btn.sm { min-height: 44px; padding: .25rem .8rem; font-size: .95rem; }
      .btn.off { opacity: .55; cursor: default; border-style: dashed; }
      .btn.copy { min-width: 11.5rem; } .btn.copy.done { background: var(--ok-bg); color: var(--olive); border-color: var(--olive); }
      h3 { font-size: 1.05rem; margin: .25rem 0 .5rem; }
      details.srow { border-top: 1px solid var(--line); } details.srow:first-child { border-top: 0; }
      details.srow > summary { cursor: pointer; padding: .75rem 0; min-height: 56px; display: flex; gap: .6rem; align-items: flex-start; list-style: none; }
      details.srow > summary::before { content: '▾'; flex: none; width: 1.2rem; line-height: 1.55; text-align: center; transform: rotate(-90deg); } details.srow[open] > summary::before { transform: none; }
      .sbody { padding: 0 0 1rem; }
      ul.dates { list-style: none; margin: 0 0 1rem; padding: 0; }
      .drow { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; justify-content: space-between; padding: .6rem 0; border-top: 1px solid var(--line); }
      .drow:first-child { border-top: 0; }
      .gtiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; margin-bottom: 1.25rem; }
      .gtile, .tpl { display: flex; flex-direction: column; gap: .2rem; text-align: left; font: inherit; color: inherit; background: var(--card); border: 2px solid var(--field); border-radius: 6px; padding: .8rem 1rem; min-height: 72px; cursor: pointer; width: 100%; }
      .gtile:hover, .tpl:hover { border-color: var(--night); background: var(--stone); }
      .tpls { display: grid; gap: .6rem; margin-bottom: 1.25rem; } .tplrow { display: flex; gap: .6rem; align-items: stretch; flex-wrap: wrap; } .tplrow .tpl { flex: 1 1 18rem; width: auto; }
      .eform { padding-bottom: 5rem; }
      .fgroup { border: 0; background: var(--card); border-radius: 6px; padding: 1.25rem; margin: 0 0 1.25rem; box-shadow: 0 1px 2px rgb(29 29 38 / .12); min-width: 0; }
      .fgroup legend { font-weight: 700; font-size: 1.15rem; float: left; width: 100%; padding: 0; margin: 0 0 .75rem; }
      .fgrid { clear: both; display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
      .fgrid > .wide, .fgrid .fld.wide { grid-column: 1 / -1; } .fgrid > .say { grid-column: 1 / -1; }
      .check { display: flex; gap: .75rem; align-items: flex-start; min-height: 48px; padding: .4rem 0; margin: 0 0 .5rem; cursor: pointer; }
      .check input, .rcard input, .seg1 input { width: 24px; height: 24px; flex: none; margin: 0; accent-color: var(--night); }
      .rcards { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; margin-top: .3rem; }
      .rcard { display: grid; grid-template-columns: 24px 1fr; column-gap: .6rem; align-items: start; border: 2px solid var(--field); border-radius: 6px; padding: .7rem .8rem; min-height: 56px; cursor: pointer; background: var(--card); }
      .rcard small { grid-column: 2; color: var(--ink-2); } .rcard:has(input:checked) { border-color: var(--night); background: var(--stone); }
      .segr { display: flex; margin-top: .3rem; border: 2px solid var(--night); border-radius: 6px; overflow: hidden; }
      .seg1 { flex: 1; display: flex; align-items: center; justify-content: center; gap: .4rem; min-height: 48px; padding: 0 .5rem; cursor: pointer; font-size: .95rem; background: var(--card); }
      .seg1 input { position: absolute; opacity: 0; width: 1px; height: 1px; } .seg1:has(input:checked) { background: var(--night); color: var(--on-dark); } .seg1:has(input:focus-visible) { outline: 3px solid var(--ink); outline-offset: -4px; }
      .say { background: var(--edit-bg); color: var(--edit); border-radius: 6px; padding: .5rem .8rem; margin: 0 0 1rem; font-weight: 600; }
      .errsum { background: var(--bad-bg); color: var(--red-ink); border-radius: 6px; padding: .8rem 1rem; margin: 0 0 1.25rem; font-weight: 700; } .errsum ul { margin: .4rem 0 0; padding-left: 1.2rem; } .errsum a { color: inherit; }
      .savebar { position: sticky; bottom: 0; z-index: 5; display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; justify-content: flex-end; background: var(--card); border-top: 2px solid var(--night); padding: .75rem 1rem; margin: 0 -1.5rem -5rem; }
      .sb-msg { margin-right: auto; font-weight: 700; color: var(--gold-ink); }
      dialog.ask.wide { max-width: 34rem; } dialog.ask textarea { margin-top: .5rem; }
      .drw { display: grid; grid-template-columns: 1fr 1fr auto; gap: 0 .75rem; align-items: end; } .drw .btn { margin-bottom: 1.1rem; }
      .date-rows { margin-bottom: .5rem; }
      body:has(.savebar) .toast { bottom: 6rem; }
      input[type=search] { display: block; width: 100%; min-height: 52px; margin-top: .3rem; padding: .55rem .7rem; font: inherit; color: inherit; background: var(--card); border: 2px solid var(--field); border-radius: 6px; }
      .main:has(.ewrap) { max-width: 82rem; }
      .ewrap { display: grid; gap: 0 1.25rem; align-items: start; } .ewrap .savebar { margin: 0 0 -5rem; }
      @media (min-width: 1100px) { .ewrap { grid-template-columns: minmax(0, 1fr) 24rem; } .ewrap > .pv { position: sticky; top: 1rem; } }
      .pv { background: var(--card); border-radius: 6px; padding: .25rem 1rem 1rem; margin: 0 0 1.25rem; box-shadow: 0 1px 2px rgb(29 29 38 / .12); }
      .pv summary { cursor: pointer; font-weight: 700; min-height: 56px; display: flex; align-items: center; }
      .pv iframe { width: 100%; height: 22rem; border: 0; display: block; color-scheme: light; }
      details.srow { border-left: 6px solid var(--gc, var(--stone)); padding-left: .75rem; }
      .gchips { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1rem; }
      .gchip { display: inline-flex; align-items: center; gap: .5rem; min-height: 48px; padding: 0 1rem; border: 2px solid var(--field); border-radius: 999px; background: var(--card); font: inherit; font-weight: 700; color: inherit; cursor: pointer; }
      .gchip i { width: 14px; height: 14px; border-radius: 3px; background: var(--gc, var(--stone)); flex: none; outline: 1px solid rgb(255 255 255 / .7); }
      .gchip .n { font-size: .85rem; color: var(--ink-2); } .gchip[aria-pressed=true] { background: var(--night); color: var(--on-dark); border-color: var(--night); } .gchip[aria-pressed=true] .n { color: var(--on-dark); }
      .hrow { display: grid; grid-template-columns: 8rem 7.5rem 1fr 1fr; gap: .25rem 1rem; align-items: center; border-top: 1px solid var(--line); padding: .5rem 0; margin: 0; }
      .hrow > .ferr, .hrow > .hnote { grid-column: 1 / -1; margin: 0; } .hrow .hnote:empty { display: none; } .hday { margin: 0; font-size: 1.05rem; }
      .tl { font-size: .9rem; font-weight: 600; } .tl input { margin-top: .1rem; }
      .orow { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: flex-end; border-top: 1px solid var(--line); padding: .75rem 0; margin: 0; }
      .orow > .tl { flex: 1 1 9rem; } .orow > .onote { flex: 1 1 100%; } .orow > .ferr { flex: 1 1 100%; margin: 0; } .orow > .check { margin: 0; }
      .pimg { width: 240px; max-width: 100%; height: 180px; object-fit: cover; border-radius: 6px; display: block; margin-bottom: .6rem; }
      .pimg.none { display: grid; place-items: center; border: 2px dashed var(--field); color: var(--ink-2); font-weight: 600; }
      .picker { margin-top: 1rem; padding: 1rem; background: var(--stone); border-radius: 6px; }
      .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: .6rem; max-height: 24rem; overflow: auto; padding: 4px; margin-bottom: 1rem; }
      label.pick { position: relative; display: block; margin: 0; aspect-ratio: 4 / 3; border-radius: 6px; background: var(--card); cursor: pointer; overflow: hidden; }
      label.pick img { width: 100%; height: 100%; object-fit: cover; display: block; }
      label.pick.up { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .3rem; border: 2px dashed var(--field); font-weight: 700; text-align: center; }
      label.pick:has(input:checked) { outline: 3px solid var(--ink); outline-offset: -3px; } label.pick:has(input:focus-visible) { outline: 3px solid var(--ink); outline-offset: 2px; }
      label.pick .chosen { display: none; position: absolute; right: 6px; top: 6px; gap: .25rem; align-items: center; background: var(--ink); color: var(--on-dark); border-radius: 999px; padding: 0 .55rem; font-size: .85rem; font-weight: 700; } label.pick:has(input:checked) .chosen { display: flex; }
      .picker .preview img { width: 100%; height: auto; border-radius: 6px; display: block; margin-bottom: .75rem; }
      @media (max-width: 800px) {
        .gtiles { grid-template-columns: 1fr 1fr; } .savebar { margin: 0 -1rem -5rem; } .btn.sm { min-height: 48px; }
        .hrow { grid-template-columns: 1fr 1fr; } .hrow .hclosed { justify-self: end; }
        .fgrid { grid-template-columns: 1fr; } .rcards { grid-template-columns: 1fr; } .drow .dact { width: 100%; } body:has(.savebar) .toast { bottom: 10rem; }
      }
      @media (max-width: 800px) {
        .wrap { grid-template-columns: minmax(0, 1fr); }
        .side { display: none; }
        .top { display: flex; position: sticky; top: 0; z-index: 10; height: 64px; background: var(--night); align-items: center; justify-content: space-between; padding: 0 1rem; }
        .mnav summary { list-style: none; display: flex; align-items: center; gap: .5rem; min-height: 48px; padding: 0 1rem; color: var(--on-dark); font-weight: 700; border: 2px solid var(--accent); border-radius: 6px; cursor: pointer; }
        .mnav summary::-webkit-details-marker { display: none; }
        .mnav > div { position: absolute; left: 0; right: 0; top: 64px; background: var(--night); padding: .5rem 1rem 1rem; max-height: calc(100vh - 64px); overflow: auto; }
        .mnav a, .mnav .linkbtn { min-height: 56px; }
        .main { padding: 1rem; }
        .btn { min-height: 52px; }
        .two { grid-template-columns: 1fr; }
        .num { font-size: 2.2rem; }
        .seg { display: grid; grid-template-columns: 1fr 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="gate" id="gate" hidden>
      <form class="card" id="login" novalidate>
        <span class="wordmark">Mulligan Games</span>
        <h1>Store admin</h1>
        <p class="meta">Sign in to run the store's website.</p>
        <div class="fld"><label for="lu">Username</label><input id="lu" type="text" name="username" autocomplete="username" autocapitalize="off" spellcheck="false" required /></div>
        <div class="fld"><label for="lp">Password</label><input id="lp" type="password" name="password" autocomplete="current-password" required /></div>
        <p class="err" id="login-err" role="alert" hidden></p>
        <button class="btn" type="submit">Sign in</button>
      </form>
      <p><a href="/">Back to the website</a></p>
    </div>

    <div class="wrap" id="app" hidden>
      <header class="top">
        <a class="wordmark" href="#dashboard">Mulligan Games</a>
        <details class="mnav" id="mnav">
          <summary><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>Menu</summary>
          <div id="mlinks"></div>
        </details>
      </header>
      <aside class="side">
        <div class="brand"><a class="wordmark" href="#dashboard">Mulligan Games</a><p>Store admin</p></div>
        <nav id="links" aria-label="Admin sections"></nav>
        <div class="tail" id="tail"></div>
      </aside>
      <main class="main" id="main" tabindex="-1">
        <div class="banner" id="default-warning" hidden><span>The password is still the starter password. Please change it now.</span><a class="btn" href="#account">Change the password</a></div>
        <section data-section="dashboard"></section>
        <section data-section="events" hidden></section>
        <section data-section="store" hidden></section>
        <section data-section="security" hidden></section>
        <section data-section="account" hidden></section>
      </main>
    </div>
    <div class="toast" id="toast" role="status" hidden></div>

    <script is:inline>
      const $ = (s, r = document) => r.querySelector(s);
      const h = (tag, props, ...kids) => {
        const el = document.createElement(tag);
        for (const [k, v] of Object.entries(props || {})) {
          if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
          else if (k === 'value' || k === 'checked') el[k] = v;
          else if (v !== false && v != null) el.setAttribute(k, v === true ? '' : v);
        }
        for (const kid of kids.flat()) if (kid != null && kid !== false) el.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
        return el;
      };
      // replaceChildren() does not flatten arrays (they print as "[object HTMLDivElement]"), so every redraw goes through put().
      const put = (el, ...kids) => el.replaceChildren(...kids.flat(9).filter((k) => k != null && k !== false));
      const IC = { home: '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>', shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>', person: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>',
        ext: '<path d="M7 17L17 7M9 7h8v8"/>', up: '<path d="M12 19V5M5 12l7-7 7 7"/>', down: '<path d="M12 5v14M5 12l7 7 7-7"/>', check: '<path d="M5 12l5 5 9-10"/>',
