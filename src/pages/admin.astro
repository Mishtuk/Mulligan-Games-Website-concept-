        pollT = setInterval(() => { if (!document.hidden && host.isConnected && !host.closest('[hidden]') && !busy()) load(true); }, 30000);
        return { load };
      }

      // ----- Today: today's events as 2-line buttons, then the roster of the one picked (DESIGN 9.2) -----
      let tsel = null; // 'series|slot': a one-off date's slot is just the day, so two series can share one
      const tkey = (x) => x.s.id + '|' + x.o.slot;
      async function renderToday() {
        guard = null;
        const sec = $('[data-section=today]');
        if (!(await loadEv())) return;
        const day = EV.today, list = [];
        for (const s of EV.series) for (const o of EV.upcoming[s.id] || []) if (o.date === day && !o.cancelled) list.push({ s, o, d: null });
        list.sort((a, b) => (a.o.start || '').localeCompare(b.o.start || ''));
        const head = h('div', { class: 'today-head' }, h('h1', {}, 'Today, ' + UTC(day, { weekday: 'long', month: 'short', day: 'numeric' })));
        if (!list.length) {
          let nx = null;
          for (const s of EV.series) for (const o of EV.upcoming[s.id] || []) if (o.date > day && !o.cancelled && (!nx || (o.date + (o.start || '')) < (nx.o.date + (nx.o.start || '')))) nx = { s, o };
          setBadge('today', 0);
          return put(sec, head, h('div', { class: 'empty-today' }, h('p', { class: 'empty-h' }, 'Nothing on today.'), h('p', {}, nx ? `The next event is ${nx.s.title}, ${wd(nx.o.date)}${nx.o.start ? ' at ' + T12(nx.o.start) : ''}.` : 'Nothing is scheduled yet.'), h('a', { class: 'btn btn-act', href: '#events' }, 'Make a one-off event')));
        }
        await Promise.all(list.map(async (x) => { const r = await api('GET', `admin/roster/${enc(x.s.id)}/${enc(x.o.slot)}`); if (r.ok) x.d = r.data; }));
        if (!list.some((x) => tkey(x) === tsel)) {
          const n = etNow(), on = list.filter((x) => x.o.start && mins(x.o.start) <= n.m && n.m < (x.o.end ? mins(x.o.end) : mins(x.o.start) + 180)), nxt = list.filter((x) => x.o.start && mins(x.o.start) > n.m);
          tsel = tkey(on[0] || nxt[0] || list[list.length - 1]);
        }
        const countText = (x) => { const e = x.d?.event, c = x.d?.counts; if (!e) return ''; if (e.signup === 'walkin') return 'Walk-in'; if (e.signup === 'external') return 'Sign up on another site'; return `${c.in}${e.capacity ? ' of ' + e.capacity : ''} signed up${c.waitlist ? ', ' + c.waitlist + ' waiting' : ''}`; };
        const sel = h('ul', { class: 'evsel' });
        let host = h('div', { class: 'roster' });
        const drawSel = () => { put(sel, list.map((x) => h('li', {}, h('button', { class: 'evb', type: 'button', 'data-game': x.s.game, 'aria-pressed': String(tkey(x) === tsel), onclick: () => { tsel = tkey(x); drawSel(); open(); } },
          h('span', { class: 'evb-t' }, h('b', {}, x.o.start ? T12(x.o.start) : ''), x.s.title), h('span', { class: 'evb-c' }, countText(x)))))); setBadge('today', list.filter((x) => x.d && underMin(x.d.event, x.d.counts)).length); };
        // A fresh host per pick: a toast Undo from the event shown before draws into the old, detached one and redraws Today instead of swapping the roster under the staff
        const open = () => { const x = list.find((y) => tkey(y) === tsel), hst = h('div', { class: 'roster' }); host.replaceWith(hst); host = hst;
          mountRoster(hst, x.s.id, x.o.slot, { onLoad: (d) => { x.d = d; drawSel(); if (cur === 'today' && (d.event.cancelled || !hst.isConnected)) renderToday(); } }).load(); };
        put(sec, head, h('nav', { 'aria-label': 'Events today' }, sel), host);
        drawSel(); open();
      }
      function renderRosterPage([sid, slot]) {
        guard = null;
        const sec = $('[data-section=roster]');
        if (!sid || !slot) { location.hash = 'events'; return; }
        const host = h('div', { class: 'roster' });
        put(sec, host); mountRoster(host, sid, slot, { page: true }).load();
      }

      // ---------- navigation ----------
      const VIEWS = { today: renderToday, roster: renderRosterPage, dashboard: renderDashboard, events: renderEvents, store: renderStore, security: renderSecurity, account: renderAccount };
      const TITLE = { today: 'Today', roster: 'Roster', dashboard: 'Dashboard', events: 'Events', store: 'Store info', security: 'Security log', account: 'Account' };
      let cur = '', restoring = false;
      function show() {
        const parts = location.hash.slice(1).split('/'), v = VIEWS[parts[0]] ? parts[0] : 'today', lit = v === 'roster' ? 'events' : v;
        cur = v; stopToday();
        document.querySelectorAll('[data-section]').forEach((s) => (s.hidden = s.dataset.section !== v));
        document.querySelectorAll('[data-view]').forEach((a) => (a.dataset.view === lit ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current')));
        $('#top-title').textContent = TITLE[v];
        VIEWS[v](parts.slice(1).map(decodeURIComponent));
      }
      async function start() {
        const r = await api('GET', 'admin/state');
        if (!r.ok) return showLogin();
        S = r.data;
        put($('#links'), sideLinks()); put($('#tabs'), tabLinks()); put($('#mlinks'), moreLinks());
        document.querySelectorAll('.who').forEach((e) => (e.textContent = S.user));
        $('#gate').hidden = true; $('#app').hidden = false;
        $('#default-warning').hidden = !S.defaultPassword;
        show();
        api('GET', 'admin/security').then((sr) => { if (sr.ok) setBadge('security', sr.data.events.filter((e) => e.at > Date.now() - 7 * 864e5 && ['warn', 'bad'].includes(evInfo(e).kind)).length); });
      }
      addEventListener('hashchange', async () => {
        if (!S) return;
        if (restoring) { restoring = false; return; }
        if (!(await leave())) { restoring = true; location.hash = cur; return; }
        show();
      });
      addEventListener('beforeunload', (e) => { if (guard?.()) e.preventDefault(); });
      start();
    </script>
  </body>
</html>
