---
// Store admin (look A, D28). A static page with no secrets: signed-out visitors see the sign-in form, and every read or save goes to /api/admin/*,
// where server.js checks the session cookie. Shell (9.1): charcoal sidebar from 1024px, top bar + bottom tab bar under it. Today and the roster are P2.4b (9.2, 9.4, 15.7).
import '../styles/global.css';
import '../styles/admin.css';
import Icon from '../components/Icon.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>try { var s = localStorage.getItem('mg-scheme'); if (s) document.querySelector('meta[name="color-scheme"]').content = s; } catch (e) {}</script>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#26211D" />
    <link rel="icon" href="/img/logo/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/img/logo/logo-180.png" />
    <title>Admin | Mulligan Games</title>
    <script src="/js/site.js" defer is:inline></script>
  </head>
  <body class="adm">
    <div class="gate" id="gate" hidden>
      <span class="plate"><img src="/img/logo/logo-plate-330.webp" alt="Mulligan Games" width="330" height="102" /></span>
      <form class="card" id="login" novalidate>
        <h1>Store admin</h1>
        <p class="meta">Sign in to run the store's website.</p>
        <div class="fld"><label for="lu">Username</label><input id="lu" type="text" name="username" autocomplete="username" autocapitalize="off" spellcheck="false" required /></div>
        <div class="fld"><label for="lp">Password</label><input id="lp" type="password" name="password" autocomplete="current-password" required /></div>
        <p class="err" id="login-err" role="alert" hidden></p>
        <button class="btn btn-act" type="submit">Sign in</button>
      </form>
      <p><a href="/">Back to the website</a></p>
    </div>

    <div class="adm-app" id="app" hidden>
      <aside class="adm-side">
        <a class="side-brand" href="#today" aria-label="Mulligan Games shop admin, Today"><span class="plate plate-lg"><img src="/img/logo/logo-plate-330.webp" alt="" width="330" height="102" /></span><span class="side-name">Shop admin</span></a>
        <nav aria-label="Admin sections"><ul class="side-nav" id="links"></ul></nav>
        <div class="side-foot">
          <details class="acct"><summary><Icon name="users" /><span>Signed in as <span class="who"></span></span></summary>
            <div class="acct-pop"><a href="#account"><Icon name="lock" />Change password</a><button type="button" data-signout><Icon name="door" />Sign out</button></div></details>
          <div class="scheme" role="group" aria-label="Colour theme">
            <span class="scheme-k" aria-hidden="true">Theme</span>
            <button type="button" data-scheme="light" aria-pressed="false"><Icon name="sun" /><span>Light</span></button>
            <button type="button" data-scheme="dark" aria-pressed="false"><Icon name="moon" /><span>Dark</span></button>
          </div>
        </div>
      </aside>
      <div class="adm-col">
        <header class="adm-top">
          <a href="#today" aria-label="Mulligan Games shop admin, Today"><span class="plate plate-sm"><img src="/img/logo/logo-plate-330.webp" alt="" width="330" height="102" /></span></a>
          <p class="top-title" id="top-title">Today</p>
          <div class="scheme top-scheme" role="group" aria-label="Colour theme">
            <span class="scheme-k" aria-hidden="true">Theme</span>
            <button type="button" data-scheme="light" aria-pressed="false"><Icon name="sun" /><span>Light</span></button>
            <button type="button" data-scheme="dark" aria-pressed="false"><Icon name="moon" /><span>Dark</span></button>
          </div>
          <details class="acct"><summary aria-label="Signed in menu"><Icon name="users" /><span class="who"></span></summary>
            <div class="acct-pop"><a href="#account"><Icon name="lock" />Change password</a><button type="button" data-signout><Icon name="door" />Sign out</button></div></details>
        </header>
        <main class="adm-main" id="main" tabindex="-1">
          <div class="wrap-adm">
            <div class="adm-warn" id="default-warning" hidden><span>The password is still the starter password. Please change it now.</span><a class="btn btn-2" href="#account">Change the password</a></div>
            <section data-section="today"></section>
            <section data-section="roster" hidden></section>
            <section data-section="dashboard" hidden></section>
            <section data-section="events" hidden></section>
            <section data-section="store" hidden></section>
            <section data-section="security" hidden></section>
            <section data-section="account" hidden></section>
          </div>
        </main>
      </div>
      <nav class="adm-tabs" aria-label="Sections"><ul id="tabs"></ul></nav>
    </div>

    <dialog class="dlg" id="more" aria-labelledby="more-t">
      <div class="dlg-in"><div class="dlg-top"><h2 id="more-t" class="dlg-h">More</h2><button type="button" class="dlg-x" data-more-close aria-label="Close"><Icon name="cancel" /></button></div>
        <div class="dlg-body"><ul class="more-list" id="mlinks"></ul>
          <ul class="more-list">
            <li><a class="btn btn-2" href="#account"><Icon name="lock" />Change password</a></li>
            <li><div class="scheme" role="group" aria-label="Colour theme"><span class="scheme-k" aria-hidden="true">Theme</span>
              <button type="button" data-scheme="light" aria-pressed="false"><Icon name="sun" /><span>Light</span></button>
              <button type="button" data-scheme="dark" aria-pressed="false"><Icon name="moon" /><span>Dark</span></button></div></li>
            <li><button type="button" class="btn btn-2" data-signout><Icon name="door" />Sign out<span class="vh"> of <span class="who"></span></span></button></li>
          </ul></div></div>
    </dialog>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <noscript><p class="noscript">The admin needs JavaScript.</p></noscript>

    <script is:inline>
      const $ = (s, r = document) => r.querySelector(s);
      const h = (tag, props, ...kids) => {
        const el = document.createElement(tag);
        for (const [k, v] of Object.entries(props || {})) {
          if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
          else if (k === 'value' || k === 'checked') el[k] = v;
          else if (v !== false && v != null) el.setAttribute(k, v === true ? '' : v);
        }
        for (const kid of kids.flat(9)) if (kid != null && kid !== false) el.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
        return el;
      };
      // replaceChildren() does not flatten arrays (they print as "[object HTMLDivElement]"), so every redraw goes through put().
      const put = (el, ...kids) => el.replaceChildren(...kids.flat(9).filter((k) => k != null && k !== false));
      const IC = { home: '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>', shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>', person: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>',
        ext: '<path d="M7 17L17 7M9 7h8v8"/>', up: '<path d="M12 19V5M5 12l7-7 7 7"/>', down: '<path d="M12 5v14M5 12l7 7 7-7"/>', check: '<path d="M5 12l5 5 9-10"/>',
        warn: '<path d="M12 3l10 18H2z"/><path d="M12 10v5M12 18v.01"/>', bshield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9.5 9.5l5 5M14.5 9.5l-5 5"/>',
        pencil: '<path d="M4 20l1-5L16 4l4 4L9 19z"/>', bin: '<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>', door: '<path d="M5 21V3h10v18M3 21h18M12 12v.01"/>', clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
        cal: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>', copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 012-2h9"/>', plus: '<path d="M12 5v14M5 12h14"/>', back: '<path d="M15 5l-7 7 7 7"/>',
        pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>', upload: '<path d="M12 16V4M7 9l5-5 5 5M5 20h14"/>',
        dots: '<circle cx="5" cy="12" r="1.75" fill="currentColor"/><circle cx="12" cy="12" r="1.75" fill="currentColor"/><circle cx="19" cy="12" r="1.75" fill="currentColor"/>', minus: '<path d="M5 12h14"/>', usera: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0114 0"/>',
        noshow: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0113 0M16 9l5 5M21 9l-5 5"/>', eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>', x: '<path d="m6 6 12 12M18 6 6 18"/>',
        users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0113 0M16 4.8a3.5 3.5 0 010 6.4M18 14a6.5 6.5 0 013.5 6"/>', stats: '<path d="M5 20V10M12 20V4M19 20v-7"/>', hourglass: '<path d="M6.5 3h11M6.5 21h11M7.5 3c0 5 9 5 9 9s-9 4-9 9M16.5 3c0 5-9 5-9 9s9 4 9 9"/>', seat: '<path d="M7 11V5.5A1.5 1.5 0 018.5 4h7A1.5 1.5 0 0117 5.5V11M5 11h14v4H5zM7 15v5M17 15v5"/>' };
      const ico = (n, s = 20) => { const e = h('span', { class: 'ico', 'aria-hidden': 'true' }); e.innerHTML = `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">${IC[n]}</svg>`; return e; };
      const ERR = { signed_out: 'Please sign in again.', origin: 'Reload the page and try again.', current: 'The current password is not right.', too_short: 'The new password needs at least 10 characters.',
        too_easy: 'Pick a harder password.', same: 'That is the same as the old password.', too_long: 'That password is too long.', rate: 'Too many tries. Wait a little and try again.' };
      const money = (n) => Number(n).toLocaleString('en-US');
      const plural = (n, one, many) => `${money(n)} ${n === 1 ? one : many}`;
      const UTC = (d, o) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { ...o, timeZone: 'UTC' });
      const wd = (d) => UTC(d, { weekday: 'short', month: 'short', day: 'numeric' }), md = (d) => UTC(d, { month: 'short', day: 'numeric' }), mon = (d) => UTC(d, { month: 'short' });
      const ET = { timeZone: 'America/New_York' };
      const etDay = (ms) => new Date(ms).toLocaleDateString('en-CA', ET);
      let S = null, guard = null; // server state; guard() returns a warning text while the open screen has unsaved changes

      // Toast with Undo (9.1, R11): sits above the walk-in bar, stays while hovered or focused, 48px Undo, 6s.
      function toast(msg, act) {
        const t = $('#toast');
        put(t, h('span', { class: 'toast-msg' }, msg), act && h('button', { class: 'toast-btn', type: 'button', onclick: () => { t.classList.remove('on'); act.fn(); } }, act.label || 'Undo'));
        t.classList.add('on'); toast.run();
      }
      toast.run = () => { clearTimeout(toast.t); toast.t = setTimeout(() => $('#toast').classList.remove('on'), 6000); };
      { // there is no onfocusin property, so these are listeners, added once
        const t = $('#toast'), hold = () => clearTimeout(toast.t);
        t.addEventListener('mouseenter', hold); t.addEventListener('focusin', hold);
        t.addEventListener('mouseleave', () => { if (!t.contains(document.activeElement)) toast.run(); }); t.addEventListener('focusout', toast.run);
      }
      function ask(title, text, yes, keep = 'Keep it', cls = 'btn-bad') {
        return new Promise((ok) => {
          const no = h('button', { class: 'btn btn-2', type: 'button', onclick: () => d.close('no') }, keep);
          const d = h('dialog', { class: 'ask', 'aria-labelledby': 'ask-t' }, h('h2', { id: 'ask-t' }, title), h('p', {}, text),
            h('div', { class: 'row' }, h('button', { class: 'btn ' + cls, type: 'button', onclick: () => d.close('yes') }, yes), no));
          d.addEventListener('close', () => { d.remove(); ok(d.returnValue === 'yes'); });
          document.body.append(d); d.showModal(); no.focus();
        });
      }
      const leave = () => { const g = guard?.(); return g ? ask('Leave without saving?', g, 'Leave', 'Stay here') : true; };
      async function api(method, path, body) {
        const r = await fetch('/api/' + path, { method, credentials: 'same-origin', headers: body ? { 'Content-Type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined });
        const data = r.status === 413 ? { error: 'file_size' } : await r.json().catch(() => ({}));
        if (r.status === 401 && path !== 'login') showLogin();
        return { ok: r.ok, status: r.status, data };
      }
      const say = (r) => r.data.message || ERR[r.data.error] || 'Something went wrong. Try again.';

      // ---------- form fields ----------
      const clearErr = (d) => { d.classList.remove('bad'); $('.ferr', d).hidden = true; $('input,select,textarea', d)?.removeAttribute('aria-invalid'); };
      function markErr(ctl, msg) { const d = ctl.closest('.fld'), e = $('.ferr', d); d.classList.add('bad'); e.textContent = msg; e.hidden = false; ctl.setAttribute('aria-invalid', 'true'); }
      /** A labelled field: label (+ quiet "Optional" tag), hint, the control, and a place for its error. x = { optional, hint, half, cls }. */
      function fld(id, label, ctl, x = {}) {
        ctl.id = id;
        if (x.hint) ctl.setAttribute('aria-describedby', id + '-h');
        const d = h('div', { class: `fld ${x.half ? '' : 'wide'} ${x.cls || ''}` }, h('label', { for: id }, label, x.optional && h('span', { class: 'opt' }, 'Optional')),
          x.hint && h('span', { class: 'hint', id: id + '-h' }, x.hint), ctl, h('p', { class: 'ferr', role: 'alert', hidden: true }));
        ctl.addEventListener('input', () => clearErr(d));
        return d;
      }

      // ---------- sign in and navigation ----------
      function showLogin() { $('#app').hidden = true; $('#gate').hidden = false; }
      $('#login').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target, err = $('#login-err');
        err.hidden = true;
        const r = await api('POST', 'login', { username: f.username.value, password: f.password.value });
        if (!r.ok) { err.textContent = say(r); err.hidden = false; return; }
        f.password.value = '';
        start();
      });
      // Sidebar (1024+), tab bar and More sheet share these. A badge (pale yellow) shows a count: setBadge('security', n).
      const NAV = [['today', 'Today', 'clock', 'Today'], ['events', 'Events', 'cal', 'Events'], ['dashboard', 'Dashboard', 'stats', 'Dashboard'], ['store', 'Store info', 'pin', 'Store']];
      const NAV2 = [['security', 'Security log', 'shield'], ['account', 'Account', 'person']];
      const BADGE_WORD = { today: 'to decide', security: 'warnings this week' };
      const badges = {};
      const nb = (id) => h('span', { class: 'nb', 'data-nb': id, hidden: !badges[id], 'aria-label': badges[id] ? badges[id] + ' ' + BADGE_WORD[id] : null }, badges[id] || '');
      function setBadge(id, n) { badges[id] = n; document.querySelectorAll('[data-nb=' + id + ']').forEach((e) => { e.hidden = !n; e.textContent = n || ''; if (n) e.setAttribute('aria-label', n + ' ' + BADGE_WORD[id]); }); }
      const sideLinks = () => [NAV.map(([id, t, i]) => h('li', {}, h('a', { href: '#' + id, 'data-view': id }, ico(i), h('span', {}, t), nb(id)))), h('li', {}, h('hr')),
        NAV2.map(([id, t, i]) => h('li', {}, h('a', { href: '#' + id, 'data-view': id }, ico(i), h('span', {}, t), nb(id)))),
        h('li', {}, h('a', { href: '/', target: '_blank', rel: 'noopener' }, ico('ext'), 'View the website', h('span', { class: 'vh' }, ' (opens in a new tab)')))];
      const tabLinks = () => [NAV.slice(0, 4).map(([id, , i, short]) => h('li', {}, h('a', { href: '#' + id, 'data-view': id }, ico(i, 24), h('span', {}, short), nb(id)))),
        h('li', {}, h('button', { type: 'button', onclick: () => $('#more').showModal() }, ico('dots', 24), h('span', {}, 'More')))];
      const moreLinks = () => [h('li', {}, h('a', { class: 'btn btn-2', href: '#security' }, ico('shield'), 'Security log', nb('security'))), h('li', {}, h('a', { class: 'btn btn-2', href: '/', target: '_blank', rel: 'noopener' }, ico('ext'), 'View the website'))];
      async function signOut() { if (!(await leave())) return; guard = null; await api('POST', 'logout'); location.reload(); }
      document.addEventListener('click', (e) => {
        if (e.target.closest('[data-signout]')) signOut();
        if (e.target.closest('[data-more-close]')) $('#more').close();
        if (e.target.closest('#more a')) $('#more').close();
        const a = e.target.closest('.acct-pop a'); if (a) a.closest('details').open = false;
      });
      $('#more').addEventListener('click', (e) => { if (e.target === e.currentTarget) e.currentTarget.close(); });

      // ---------- dashboard ----------
      let range = '30d';
      const RANGES = [['7d', '7 days', 'the 7 days before'], ['30d', '30 days', 'the 30 days before'], ['90d', '90 days', 'the 90 days before'], ['365d', 'Year', 'the year before']];
      const PAGES = { '/': 'Home' }; // friendly names for the page list; add pages as they are built
      const pageName = (p) => PAGES[p] || ((s) => s.charAt(0).toUpperCase() + s.slice(1))(p.split('/').filter(Boolean).pop()?.replace(/-/g, ' ') || 'Home');
      const SITES = [[/^maps\.google\./, 'Google Maps'], [/(^|\.)(facebook|fb)\.com$/, 'Facebook'], [/(^|\.)google\.[a-z.]+$/, 'Google'], [/(^|\.)bing\.com$/, 'Bing'], [/(^|\.)duckduckgo\.com$/, 'DuckDuckGo'],
        [/(^|\.)yahoo\.com$/, 'Yahoo'], [/(^|\.)instagram\.com$/, 'Instagram'], [/(^|\.)discord\.(com|gg)$/, 'Discord'], [/(^|\.)topdeck\.gg$/, 'TopDeck']];
      const siteName = (host) => { const x = host.replace(/^www\./, ''); return SITES.find(([re]) => re.test(x))?.[1] || x; };
      const merge = (rows, name) => [...rows.reduce((m, r) => m.set(name(r), (m.get(name(r)) || 0) + r.n), new Map())].sort((a, b) => b[1] - a[1]);
      function change(cur, prev, before) {
        if (!cur && !prev) return null;
        const diff = cur - prev, pct = prev >= 5 ? Math.round((Math.abs(diff) / prev) * 100) : 0;
        if (!diff || (prev >= 5 && !pct)) return h('div', { class: 'chg' }, `Same as ${before}`);
        const up = diff > 0, words = prev >= 5 ? `${up ? 'Up' : 'Down'} ${pct}% on ${before}` : `${money(Math.abs(diff))} ${up ? 'more' : 'fewer'} than ${before}`;
        return h('div', { class: 'chg' + (up ? ' up' : '') }, ico(up ? 'up' : 'down', 16), words);
      }
      function bars(series, r) {
        if (r === '90d') return { head: 'Visitors per week', bs: Array.from({ length: Math.ceil(series.length / 7) }, (_, i) => { const w = series.slice(i * 7, i * 7 + 7), n = w.reduce((a, p) => a + p.n, 0); return { n, label: md(w[0].day), title: `Week of ${wd(w[0].day)}: ${plural(n, 'visitor', 'visitors')}` }; }) };
        if (r === '365d') { const by = new Map(); for (const p of series) by.set(p.day.slice(0, 7), (by.get(p.day.slice(0, 7)) || 0) + p.n); return { head: 'Visitors per month', bs: [...by].map(([k, n], i, all) => ({ n, label: i === 0 || i === all.length - 1 ? UTC(k + '-15', { month: 'short', year: 'numeric' }) : mon(k + '-15'), title: `${UTC(k + '-15', { month: 'long', year: 'numeric' })}: ${plural(n, 'visitor', 'visitors')}` })) }; }
        return { head: 'Visitors per day', bs: series.map((p) => ({ n: p.n, label: md(p.day), title: `${wd(p.day)}: ${plural(p.n, 'visitor', 'visitors')}` })) };
      }
      function chart(bs, label, W) {
        const H = 220, L = 38, B = 26, T = 12, R = 6, max = Math.max(...bs.map((b) => b.n)), top = [5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000].find((x) => x >= max) || Math.ceil(max / 1000) * 1000;
        const y = (n) => T + (H - T - B) * (1 - n / top), slot = (W - L - R) / bs.length, bw = slot / 1.25, hi = bs.findIndex((b) => b.n === max);
        // D20: every node is made with createElementNS and every string set as an attribute or textContent, never innerHTML
        const NS = 'http://www.w3.org/2000/svg';
        const s = (tag, attrs = {}, text) => { const n = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, v); if (text !== undefined) n.textContent = text; return n; };
        const svg = s('svg', { viewBox: `0 0 ${W} ${H}`, class: 'chart', role: 'img', 'aria-label': label });
        for (const v of [0, top / 2, top]) svg.append(s('line', { class: 'gl', x1: L, x2: W - R, y1: y(v), y2: y(v) }), s('text', { x: L - 6, y: y(v) + 4, 'text-anchor': 'end' }, String(v)));
        bs.forEach((b, i) => {
          const hh = (H - B - T) * (b.n / top), r = Math.min(2, hh), x = L + i * slot + (slot - bw) / 2, g = s('g');
          g.append(s('title', {}, b.title));
          if (hh) g.append(s('path', { class: 'bar' + (i === hi ? ' hi' : ''), d: `M${x} ${H - B}v${-(hh - r)}q0 ${-r} ${r} ${-r}h${bw - 2 * r}q${r} 0 ${r} ${r}v${hh - r}z` }));
          g.append(s('rect', { x: L + i * slot, y: T, width: slot, height: H - T - B, fill: 'transparent' }));
          svg.append(g);
        });
        const lab = (i, a) => svg.append(s('text', { x: a === 'start' ? L + i * slot : a === 'end' ? L + (i + 1) * slot - (slot - bw) / 2 : L + i * slot + slot / 2, y: H - 6, 'text-anchor': a }, bs[i].label));
        lab(0, 'start');
        if (bs.length > 2) lab(Math.floor((bs.length - 1) / 2), 'middle');
        if (bs.length > 1) lab(bs.length - 1, 'end');
        return svg;
      }
      async function renderDashboard() {
        guard = null;
        const sec = $('[data-section=dashboard]');
        const r = await api('GET', 'admin/stats?range=' + range);
        if (!r.ok) return;
        const d = r.data, before = RANGES.find((x) => x[0] === d.range)[2], period = d.range === '365d' ? 'Last year' : 'Last ' + d.range.replace('d', ' days');
        const best = d.series.reduce((a, p) => (p.n > a.n ? p : a), { n: 0 });
        const sentence = best.n ? `Busiest day: ${wd(best.day)}, with ${plural(best.n, 'visitor', 'visitors')}.` : 'No visitors counted in this period yet.';
