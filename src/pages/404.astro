---
import Base from '../components/Base.astro';
---
<Base title="Page not found | Mulligan Games" description="That page isn't here." skip="#main" skipLabel="Skip to the message">
  <main id="main">
    <div class="wrap dp-wrap">
      <div class="empty lattice" role="note">
        <h1 class="empty-h">We couldn’t find that page.</h1>
        <p>Try the events list, or the front page.</p>
        <p class="visit-acts"><a class="btn btn-act" href="/events/">See all events</a><a class="btn btn-2" href="/">Front page</a></p>
      </div>
    </div>
  </main>
</Base>
