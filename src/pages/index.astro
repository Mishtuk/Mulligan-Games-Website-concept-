---
// Front page (DESIGN.md 6). The fixed copy and layout are built here; every live region is a <!--mg:name--> marker that server.js fills from the
// database on each request (src/lib/render.js), so admin edits and cancellations show without a rebuild. The baked text between a marker pair
// is what a visitor sees if the server cannot fill it.
import Base from '../components/Base.astro';
import Icon from '../components/Icon.astro';
import store from '../content/store.json';
import { safeUrl } from '../lib/events.js';
import proof from '../content/proof.json';
import { entryText } from '../lib/store-render.js';
import { validClip, clipPos, NAMES, FEATURED } from '../lib/clips.js';
import clipData from '../content/clips.json';

const a = store.address;
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${store.name} ${a.street} ${a.city} ${a.region} ${a.zip}`)}`;
const tel = safeUrl(store.phoneHref);
const discord = safeUrl(store.links?.discord);
const rv = proof.reviews, reviewUrl = safeUrl(rv.url);
const tcg = safeUrl(proof.tcgplayer.url);
const clips = clipData.filter(validClip), feat = FEATURED.map((id) => clips.find((c) => c.id === id)).filter(Boolean), tiktok = safeUrl(store.links?.tiktok);
const social = [['Facebook', 'facebook'], ['Instagram', 'instagram'], ['TikTok', 'tiktok'], ['X', 'x'], ['TopDeck', 'topdeck']].map(([n, k]) => [n, safeUrl(store.links?.[k])]).filter(([, u]) => u);
---
<Base title="Mulligan Games, Warminster PA: events this week" description="Card and game shop in Warminster, PA. Magic, cEDH, Pokemon, One Piece, Riftbound, Hololive and Warhammer nights every week. See what's on, sign up and plan your visit." current="home" skip="#week" skipLabel="Skip to this week's events">
  <Fragment slot="head">
    <Fragment set:html="<!--mg:shop-ld-->" />
    <!-- LCP hint: the poster that matches the video source the phone will pick (portrait phones, everyone else) -->
    <link rel="preload" as="image" href="/media/video/hero-poster-portrait.jpg" media="(max-width: 700px) and (orientation: portrait)" fetchpriority="high" />
    <link rel="preload" as="image" href="/media/video/hero-poster.jpg" media="not all and (max-width: 700px) and (orientation: portrait)" fetchpriority="high" />
  </Fragment>
  <main id="main">
    <!-- 2. Hero (round 8, #16): the shop montage plays behind the copy like the VFW and Riverside sites; white copy on a dark scrim, a strip along the bottom.
         Poster first (CSS background); site.js starts the video after load and holds it back for reduced motion / Save-Data / slow links (no inline script, D24). -->
    <section class="phero" aria-labelledby="hero-h">
      <div class="phero-media" id="hero-media" aria-hidden="true">
        <!-- No src or poster here: the box's CSS background is the poster (one file per screen, global.css), and site.js gives the sources their src
             only when the video may play, so held screens (and no JS) fetch no video at all -->
        <video id="hero-video" muted loop playsinline preload="none" tabindex="-1">
          <source media="(max-width: 700px) and (orientation: portrait)" data-src="/media/video/hero-portrait.mp4" type="video/mp4" />
          <source media="(max-width: 700px)" data-src="/media/video/hero-720.mp4" type="video/mp4" />
          <source data-src="/media/video/hero.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="wrap phero-in">
        <Fragment set:html={`<!--mg:hero--><div class="phero-copy"><p class="phero-chip" id="hero-chip" role="status"><span class="chip-dot" aria-hidden="true"></span><span id="hero-chip-t">Hours coming soon</span></p><h1 class="phero-h" id="hero-h">Shuffle up. Everyone’s welcome.</h1><p class="phero-sub" id="hero-sub">Welcome to Mulligan Games, Warminster’s friendly game store: a big play room, free play every day we’re open, and card nights all week. Come say hi.</p></div><!--/mg:hero-->`} />
      </div>
      <div class="phero-strip">
        <div class="wrap phero-strip-in">
          <p class="media-cap">On screen: the shop at 445 York Rd</p>
          {clips.length >= 3 && <a class="clips-link" href="#clips">Watch clips from the shop<Icon name="chevron" /></a>}
          <button class="vid-btn" id="vid-btn" type="button" data-paused>
            <Icon name="pause" class="i-pause" /><Icon name="play" class="i-play" />
            <span id="vid-label">Play video</span>
          </button>
        </div>
      </div>
    </section>

    <!-- 2b. Two featured clips (round 7, D51), their own compact row under the hero, never over the moving picture. Same plain links and click-to-load dialog as 3b. -->
    {feat.length > 0 && (
    <section class="feat" aria-label="Featured clips">
      <ul class="feat-in wrap" role="list">
        {feat.map((c) => (
          <li>
            <a class="clip-a feat-a" href={c.url} target="_blank" rel="noopener" data-tt={c.file ? undefined : c.id} data-file={c.file} data-caption={c.caption}>
              <span class="clip-ph"><img src={`/${c.poster}`} width={c.pw} height={c.ph} alt="" loading="lazy" decoding="async" style={`object-position:${clipPos(c)}`} /><span class="clip-play" aria-hidden="true"><Icon name="play" /></span></span>
              <span class="feat-cap"><span class="feat-k">{NAMES[c.platform]}</span><span class="feat-t"><span class="vh">Play video: </span>{c.caption}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    )}

    <!-- 3. This week: the seven-day strip first, then the days (all of it is the mg:week marker) -->
    <section class="sec week" id="week" aria-labelledby="week-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="week-h">This week</h2>
          <a class="more" href="/events/">All events and sign-ups<Icon name="chevron" /></a>
        </div>
        <Fragment set:html={`<!--mg:week--><p class="day-skip">The schedule is on the <a href="/events/">events page</a>.</p><!--/mg:week-->`} />
      </div>
    </section>

    <!-- 3b. Clips from the shop (round 6, D47): the store's own videos from src/content/clips.json. Each card is a plain link to the post (works with no JS);
         public/js/clips.js opens the official TikTok player in a dialog only after a click. Instagram cards stay links. Hidden under 3 valid clips. -->
    {clips.length >= 3 && (
    <section class="sec clips-sec" id="clips" aria-labelledby="clips-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="clips-h">Clips from the shop</h2>
          <p class="sec-note">Short videos from our TikTok and Instagram.</p>
          {tiktok && <a class="more" href={tiktok} target="_blank" rel="noopener">Follow on TikTok<span class="vh"> (opens TikTok)</span><Icon name="external" /></a>}
          <div class="clips-nav" id="clips-nav" hidden>
            <button type="button" class="clips-btn" id="clips-prev" aria-controls="clips-list" aria-label="Earlier clips" disabled><Icon name="chevron" /></button>
            <button type="button" class="clips-btn" id="clips-next" aria-controls="clips-list" aria-label="More clips"><Icon name="chevron" /></button>
          </div>
        </div>
        <div class="clips-body">
          <ul class="clips" id="clips-list" role="list">
            {clips.map((c) => (
              <li class="clip">
                <a class="clip-a" href={c.url} target="_blank" rel="noopener" data-tt={c.platform === 'tiktok' && !c.file ? c.id : undefined} data-file={c.file} data-caption={c.caption}>
                  <span class="clip-ph">
                    <img src={`/${c.poster}`} width={c.pw} height={c.ph} alt="" loading="lazy" decoding="async" style={`object-position:${clipPos(c)}`} />
                    <span class="clip-badge"><Icon name={c.file ? 'play' : c.platform} />{c.file ? 'Video' : NAMES[c.platform]}</span>
                    <span class="clip-play" aria-hidden="true"><Icon name="play" /></span>
                  </span>
                  <span class="clip-cap"><span class="vh">{c.file || c.platform === 'tiktok' ? 'Play video' : 'Watch on Instagram'}: </span>{c.caption}</span>
                  {(c.file || c.credit) && <span class="clip-by">{[c.file && `from ${NAMES[c.platform]}`, c.credit].filter(Boolean).join(' · ')}</span>}
                </a>
              </li>
            ))}
          </ul>
          <p class="clips-priv">Videos load from TikTok only when you press play, and Instagram clips open on Instagram; those sites may set their own cookies.</p>
        </div>
      </div>
    </section>
    )}
    {feat.length > 0 && <script src="/js/clips.js" defer is:inline></script>}

    <!-- 4. cEDH strip (D4) -->
    <section class="cedh" id="cedh" aria-labelledby="cedh-h">
      <div class="wrap cedh-in">
        <div class="cedh-copy">
          <h2 id="cedh-h">cEDH at Mulligan</h2>
          <p class="cedh-lede">A monthly Championship Series, 5K weekends and a November invitational. Forty to 120 players an event, and a dual land on the line every month.</p>
          <figure class="cedh-photo"><img src="/media/video/cedh-monthly-event-poster.webp" width="720" height="1280" loading="lazy" decoding="async" alt="Close-up of a cEDH game at Mulligan: playmats, sleeved decks and cards in play" /></figure>
          <dl class="cedh-facts">
            <div><dt>Prizes</dt><dd>Every Championship Series guarantees a dual land. Each winner gets an invitational seat.</dd></div>
            <div><dt>Proxies</dt><dd>Up to 10, judge-approved, printed with full rules text.</dd></div>
            <Fragment set:html="<!--mg:cedh-live-->" />
            <div><dt>Entry</dt><dd>{entryText()}</dd></div>
            {store.parking && <div><dt>Parking</dt><dd>{store.parking}</dd></div>}
            <Fragment set:html="<!--/mg:cedh-live-->" />
          </dl>
        </div>
        <div class="cedh-next">
          <h3>Next cEDH events</h3>
          <Fragment set:html={`<!--mg:cedh--><!--/mg:cedh-->`} />
          <Fragment set:html={`<!--mg:turnout--><!--/mg:turnout-->`} />
          <p><a class="turnout-more" href="/cedh/">More about cEDH at Mulligan</a></p>
        </div>
      </div>
    </section>

    <!-- 5. New and preorders -->
    <section class="sec new" id="new" aria-labelledby="new-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="new-h">New and preorders</h2>
          <p class="sec-note">Preorders are taken at the counter or by phone.</p>
        </div>
        <ul class="rel-list"><Fragment set:html={`<!--mg:releases--><!--/mg:releases-->`} /></ul>
        {tcg && <p class="tcg-line"><a href={tcg} target="_blank" rel="noopener">{proof.tcgplayer.line}<span class="vh"> (opens TCGplayer)</span></a>{proof.tcgplayer.positive && ` · ${proof.tcgplayer.positive}`}</p>}
      </div>
    </section>

    <!-- 6. Visit -->
    <section class="sec visit" id="visit" aria-labelledby="visit-h">
      <Fragment set:html="<!--mg:visit-->" />
      <div class="wrap">
        <div class="sec-head">
          <h2 id="visit-h">Visit</h2>
        </div>
        <div class="visit-in">
          <div class="visit-hours">
            <h3>Hours</h3>
            <Fragment set:html={`<!--mg:hours--><p>We’re confirming our opening hours. Call us for today’s hours.</p><!--/mg:hours-->`} />
          </div>
          <div class="visit-where">
            <h3>Find us</h3>
            <address>{a.street}<br />{a.city}, {a.region} {a.zip}</address>
            <p class="visit-acts">
              <a class="btn btn-2" href={maps} target="_blank" rel="noopener"><Icon name="pin" />Directions<span class="vh"> (opens Google Maps)</span></a>
              {tel && <a class="btn btn-2" href={tel}><Icon name="phone" />{store.phone}</a>}
            </p>
            <p class="visit-small">{store.parking && <><strong>Parking:</strong> {store.parking} </>}Look for the sign on the roof. The door is right below it.</p>
          </div>
          <div class="visit-faq">
            <h3>Good to know</h3>
            <dl class="faq">
              <dt>New here?</dt>
              <dd><a href="/new-here/">Start here.</a> What to expect and which nights are good for a first visit.</dd>
              {store.kids && <><dt>Can kids come?</dt><dd>{store.kids}</dd></>}
              {store.freePlay && <><dt>Can I just come and play?</dt><dd>{store.freePlay}.</dd></>}
              <dt>How do preorders work?</dt>
              <dd>Preorders are taken in store. Each preorder has a last day, shown above.</dd>
            </dl>
          </div>
        </div>
      </div>
      <Fragment set:html="<!--/mg:visit-->" />
    </section>

    <!-- 7. Community -->
    <section class="sec community" id="community" aria-labelledby="comm-h">
      <div class="wrap">
        <Fragment set:html="<!--mg:discord-->" />
        <div class="sec-head">
          <h2 id="comm-h">Between events</h2>
          <p class="sec-note">{discord ? 'Chat with the regulars, find a pod and hear about new events first on the shop Discord.' : 'Follow the shop to hear about new events first.'}</p>
        </div>
        <div class="comm-acts">
          {discord && <a class="btn btn-act" href={discord} target="_blank" rel="noopener"><Icon name="chat" />Join the Discord<span class="vh"> (opens Discord)</span></a>}
          <ul class="socials">
            {social.map(([n, u]) => <li><a href={u} target="_blank" rel="noopener">{n}<span class="vh"> (opens in a new tab)</span></a></li>)}
          </ul>
        </div>
        <Fragment set:html="<!--/mg:discord-->" />
        <div class="comm-proof">
          <h3>What people say</h3>
          <!-- Static: rating and quotes are content in src/content/proof.json (see its asOf) -->
          <p class="proof-rate">{reviewUrl ? <a href={reviewUrl} target="_blank" rel="noopener">{rv.rating} on {rv.source} · {rv.count} reviews<span class="vh"> (opens Google Maps)</span></a> : `${rv.rating} on ${rv.source} · ${rv.count} reviews`}</p>
          <ul class="proof">
            {rv.items.map((q) => <li><q>{q.text}</q><small>{q.name}, {q.age}</small></li>)}
          </ul>
        </div>
        <Fragment set:html={`<!--mg:lately--><!--/mg:lately-->`} />
      </div>
    </section>
  </main>
</Base>
