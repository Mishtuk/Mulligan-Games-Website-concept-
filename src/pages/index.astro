---
// Front page (DESIGN.md 6). The fixed copy and layout are built here; every live region is a <!--mg:name--> marker that server.js fills from the
// database on each request (src/lib/render.js), so admin edits and cancellations show without a rebuild. The baked text between a marker pair
// is what a visitor sees if the server cannot fill it.
import Base from '../components/Base.astro';
import Icon from '../components/Icon.astro';
import store from '../content/store.json';
import { safeUrl } from '../lib/events.js';
import proof from '../content/proof.json';
import { entryText } from '../lib/store-render.js';

const a = store.address;
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${store.name} ${a.street} ${a.city} ${a.region} ${a.zip}`)}`;
const tel = safeUrl(store.phoneHref);
const discord = safeUrl(store.links?.discord);
const rv = proof.reviews, reviewUrl = safeUrl(rv.url);
const tcg = safeUrl(proof.tcgplayer.url);
const social = [['Facebook', 'facebook'], ['Instagram', 'instagram'], ['TikTok', 'tiktok'], ['X', 'x'], ['TopDeck', 'topdeck']].map(([n, k]) => [n, safeUrl(store.links?.[k])]).filter(([, u]) => u);
---
<Base title="Mulligan Games, Warminster PA: events this week" description="Card and game shop in Warminster, PA. Magic, cEDH, Pokemon, One Piece, Riftbound, Hololive and Warhammer nights every week. See what's on, sign up and plan your visit." current="home" skip="#week" skipLabel="Skip to this week's events">
  <Fragment slot="head">
    <Fragment set:html="<!--mg:shop-ld-->" />
    <!-- LCP hint per screen: phones fetch the portrait poster, wide screens the landscape still (never both) -->
    <link rel="preload" as="image" href="/media/video/cedh-players-tables-loop-poster.webp" media="(max-width: 899px)" fetchpriority="high" />
    <link rel="preload" as="image" imagesrcset="/img/social/shop-floor-cases-800.webp 800w, /img/social/shop-floor-cases.webp 1440w" imagesizes="100vw" media="(min-width: 900px)" fetchpriority="high" />
  </Fragment>
  <main id="main">
    <!-- 2. Hero (round 3, D36): the room on a cEDH night fills the width (poster first, loop after load; site.js); white copy on a dark scrim, a strip along the bottom -->
    <section class="phero" aria-labelledby="hero-h">
      <div class="phero-media" id="hero-media">
        <!-- From 900px the landscape still; under 900px the portrait poster and loop. The video has no <source> or poster here: site.js adds them on phones only. -->
        <picture>
          <source media="(min-width: 900px)" srcset="/img/social/shop-floor-cases-800.webp 800w, /img/social/shop-floor-cases.webp 1440w" sizes="100vw" width="1440" height="1080" />
          <img src="/media/video/cedh-players-tables-loop-poster.webp" width="540" height="960" alt="Inside Mulligan Games: tables, sealed product and singles cases" fetchpriority="high" />
        </picture>
        <video id="hero-video" muted loop playsinline preload="none" width="540" height="960" aria-hidden="true" tabindex="-1"></video>
      </div>
      <div class="wrap phero-in">
        <Fragment set:html={`<!--mg:hero--><div class="phero-copy"><h1 class="phero-h" id="hero-h">Card and game nights every week in Warminster.</h1></div><!--/mg:hero-->`} />
      </div>
      <div class="phero-strip">
        <div class="wrap phero-strip-in">
          <Fragment set:html="<!--mg:free-play-->" />{store.freePlay && <p class="freeplay2">{store.freePlay}</p>}<Fragment set:html="<!--/mg:free-play-->" />
          <p class="media-cap">On screen: <span class="cap-wide">The shop floor at 445 York Rd</span><span class="cap-narrow">cEDH night at the shop</span></p>
          <button class="vid-btn" id="vid-btn" type="button" data-paused>
            <Icon name="pause" class="i-pause" /><Icon name="play" class="i-play" />
            <span id="vid-label">Play video</span>
          </button>
        </div>
      </div>
    </section>

    <!-- 3. This week at Mulligan: the seven-day strip first, then the days (all of it is the mg:week marker) -->
    <section class="sec week" id="week" aria-labelledby="week-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="week-h">This week at Mulligan</h2>
          <a class="more" href="/events/">All events and sign-ups<Icon name="chevron" /></a>
        </div>
        <Fragment set:html={`<!--mg:week--><p class="day-skip">The schedule is on the <a href="/events/">events page</a>.</p><!--/mg:week-->`} />
      </div>
    </section>

    <!-- 3b. Inside the shop: the store's own photos (D27) -->
    <section class="sec shop" id="shop" aria-labelledby="shop-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="shop-h">Inside the shop</h2>
          <p class="sec-note">A play room full of tables, a singles case and a crew who know the formats.</p>
        </div>
        <ul class="shots">
          <li class="shot shot-banner"><figure><img src="/img/social/interior-welcome-banner.webp" width="960" height="720" loading="lazy" decoding="async" alt="A Welcome to Mulligan Games banner over the doorway into the play room" /><figcaption>Through this door: the play room</figcaption></figure></li>
          <li class="shot shot-case"><figure><img src="/img/social/singles-case-lit-800.webp" srcset="/img/social/singles-case-lit-800.webp 800w, /img/social/singles-case-lit.webp 1600w" sizes="(min-width: 768px) 25vw, 78vw" width="800" height="600" loading="lazy" decoding="async" alt="A lit glass case of single cards, with Japanese and Korean sections" /><figcaption>The singles case</figcaption></figure></li>
          <li class="shot shot-corgi"><figure><img src="/img/social/shop-corgi-800.webp" srcset="/img/social/shop-corgi-800.webp 800w, /img/social/shop-corgi.webp 1070w" sizes="(min-width: 768px) 25vw, 78vw" width="800" height="1000" loading="lazy" decoding="async" alt="A Mulligan Games staff member holding the shop corgi, game posters behind" /><figcaption>Staff, and a corgi</figcaption></figure></li>
          <li class="shot shot-crew"><figure><img src="/img/social/event-full-room-800.webp" srcset="/img/social/event-full-room-800.webp 800w, /img/social/event-full-room.webp 1600w" sizes="(min-width: 768px) 50vw, 78vw" width="800" height="600" loading="lazy" decoding="async" alt="The play room full of players at tables on an event night" /><figcaption>An event night</figcaption></figure></li>
        </ul>
      </div>
    </section>

    <!-- 4. cEDH strip (D4) -->
    <section class="cedh" id="cedh" aria-labelledby="cedh-h">
      <div class="wrap cedh-in">
        <div class="cedh-copy">
          <h2 id="cedh-h">cEDH at Mulligan</h2>
          <p class="cedh-lede">A monthly Championship Series, 5K weekends and a November invitational. Forty to 120 players an event, and a dual land on the line every month.</p>
          <figure class="cedh-photo"><img src="/media/video/cedh-monthly-event-poster.webp" width="720" height="1280" loading="lazy" decoding="async" alt="Close-up of a cEDH game at Mulligan: playmats, sleeved decks and cards in play" /></figure>
          <dl class="cedh-facts">
            <div><dt>Prizes</dt><dd>Every Championship Series guarantees a dual land. Each winner gets an invitational seat.</dd></div>
            <div><dt>Proxies</dt><dd>Up to 10, judge-approved, printed with full rules text.</dd></div>
            <Fragment set:html="<!--mg:cedh-live-->" />
            <div><dt>Entry</dt><dd>{entryText()}</dd></div>
            {store.parking && <div><dt>Parking</dt><dd>{store.parking}</dd></div>}
            <Fragment set:html="<!--/mg:cedh-live-->" />
          </dl>
        </div>
        <div class="cedh-next">
          <h3>Next cEDH events</h3>
          <Fragment set:html={`<!--mg:cedh--><!--/mg:cedh-->`} />
          <Fragment set:html={`<!--mg:turnout--><!--/mg:turnout-->`} />
        </div>
      </div>
    </section>

    <!-- 5. New and preorders -->
    <section class="sec new" id="new" aria-labelledby="new-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="new-h">New and preorders</h2>
          <p class="sec-note">Preorders are taken at the counter or by phone.</p>
        </div>
        <ul class="rel-list"><Fragment set:html={`<!--mg:releases--><!--/mg:releases-->`} /></ul>
        {tcg && <p class="tcg-line"><a href={tcg} target="_blank" rel="noopener">{proof.tcgplayer.line}<span class="vh"> (opens TCGplayer)</span></a>{proof.tcgplayer.positive && ` · ${proof.tcgplayer.positive}`}</p>}
      </div>
    </section>

    <!-- 6. Visit -->
    <section class="sec visit" id="visit" aria-labelledby="visit-h">
      <Fragment set:html="<!--mg:visit-->" />
      <div class="wrap">
        <div class="sec-head">
          <h2 id="visit-h">Visit</h2>
        </div>
        <div class="visit-in">
          <div class="visit-hours">
            <h3>Hours</h3>
            <Fragment set:html={`<!--mg:hours--><p>We’re confirming our opening hours. Call us for today’s hours.</p><!--/mg:hours-->`} />
          </div>
          <div class="visit-where">
            <h3>Find us</h3>
            <address>{a.street}<br />{a.city}, {a.region} {a.zip}</address>
            <p class="visit-acts">
              <a class="btn btn-2" href={maps} target="_blank" rel="noopener"><Icon name="pin" />Directions<span class="vh"> (opens Google Maps)</span></a>
              {tel && <a class="btn btn-2" href={tel}><Icon name="phone" />{store.phone}</a>}
            </p>
            <p class="visit-small">{store.parking && <><strong>Parking:</strong> {store.parking} </>}Look for the sign on the roof. The door is right below it.</p>
          </div>
          <div class="visit-faq">
            <h3>Good to know</h3>
            <dl class="faq">
              <dt>New here?</dt>
              <dd><a href="/new-here/">Start here.</a> What to expect and which nights are good for a first visit.</dd>
              {store.kids && <><dt>Can kids come?</dt><dd>{store.kids}</dd></>}
              {store.freePlay && <><dt>Can I just come and play?</dt><dd>{store.freePlay}.</dd></>}
              <dt>How do preorders work?</dt>
              <dd>Preorders are taken in store. Each preorder has a last day, shown above.</dd>
            </dl>
          </div>
        </div>
      </div>
      <Fragment set:html="<!--/mg:visit-->" />
    </section>

    <!-- 7. Community -->
    <section class="sec community" id="community" aria-labelledby="comm-h">
      <div class="wrap">
        <Fragment set:html="<!--mg:discord-->" />
        <div class="sec-head">
          <h2 id="comm-h">Between events</h2>
          <p class="sec-note">{discord ? 'Chat with the regulars, find a pod and hear about new events first on the shop Discord.' : 'Follow the shop to hear about new events first.'}</p>
        </div>
        <div class="comm-acts">
          {discord && <a class="btn btn-act" href={discord} target="_blank" rel="noopener"><Icon name="chat" />Join the Discord<span class="vh"> (opens Discord)</span></a>}
          <ul class="socials">
            {social.map(([n, u]) => <li><a href={u} target="_blank" rel="noopener">{n}<span class="vh"> (opens in a new tab)</span></a></li>)}
          </ul>
        </div>
        <Fragment set:html="<!--/mg:discord-->" />
        <div class="comm-proof">
          <h3>What people say</h3>
          <!-- Static: rating and quotes are content in src/content/proof.json (see its asOf) -->
          <p class="proof-rate">{reviewUrl ? <a href={reviewUrl} target="_blank" rel="noopener">{rv.rating} on {rv.source} · {rv.count} reviews<span class="vh"> (opens Google Maps)</span></a> : `${rv.rating} on ${rv.source} · ${rv.count} reviews`}</p>
          <ul class="proof">
            {rv.items.map((q) => <li><q>{q.text}</q><small>{q.name}, {q.age}</small></li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>
</Base>
